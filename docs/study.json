  "blocks": [
    {
      "id": "refocus",
      "title": "Refocusing a photograph",
      "description": "The original photo is partly out of focus. Compare attempts to bring the marked subject into focus.",
      "count": 6,
      "questions": [
        {
          "id": "focus",
          "text": "Which result best brings the marked subject into focus?",
          "help": "Look for clear, believable detail at the marked location."
        },
        {
          "id": "fidelity",
          "text": "Which result best preserves the identity and structure of the original scene?",
          "help": "Compare with the original. Look for faithful objects, shapes, colors and textures rather than invented or altered content."
        },
        {
          "id": "artifacts",
          "text": "Which result has the fewest visible artifacts?",
          "help": "Look for halos, ringing, doubled edges, distorted textures or unnatural transitions."
        },
        {
          "id": "quality",
          "text": "Which result would you prefer as the final photograph?",
          "help": "Make an overall judgment of focus, naturalness and visual quality."
        }
      ]
    },
    {
      "id": "bokeh",
      "title": "Rendering depth of field",
      "description": "The original photo is mostly sharp. Compare rendered versions with a shallow depth of field. The reference is a captured photograph of the intended effect.",
      "count": 6,
      "questions": [
        {
          "id": "naturalness",
          "text": "Which result most naturally reproduces the reference depth of field?",
          "help": "Compare the blur distribution, transitions and boundaries with the reference photograph."
        },
        {
          "id": "preservation",
          "text": "Which result best preserves the subject and scene details?",
          "help": "Compare the marked subject with the original. Look for faithful detail, color and structure."
        },
        {
          "id": "artifacts",
          "text": "Which result has the fewest visible artifacts?",
          "help": "Look for edge halos, color bleeding, ghosting, patchy blur or distorted textures."
        },
        {
          "id": "quality",
          "text": "Which result would you prefer as the final photograph?",
          "help": "Make an overall judgment of the depth-of-field effect, scene fidelity and visual quality."
        }
      ]
    }
